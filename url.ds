// URL parse / request format / response parse. Host ops are summoned.
// Encoder/concat live in @deka/bytes; this file keeps the HTTP shims.
import { from_array } from "bytes"

interface Url {
  scheme: string
  host: string
  port: number
  path: string
}

interface ParsedResponse {
  complete: boolean
  error: string?
  status: number
  body: bytes
}

interface Headers {
  content_type: string
}

summon {
  parse_http_url(url: string): Exception<Url, JsError>,
  total format_http_request(method: string, path: string, host: string, headers: Headers, body: bytes): string,
  parse_http_response(buf: bytes): Exception<ParsedResponse, JsError>
} from "./boundary.mjs"

export fn parse_url(url: string) Exception<Url, JsError> {
  return parse_http_url(url)
}

export fn format_request(method: string, path: string, host: string, headers: Headers, body: bytes) string {
  return format_http_request(method, path, host, headers, body)
}

export fn parse_response(buf: bytes) Exception<ParsedResponse, JsError> {
  return parse_http_response(buf)
}

export fn no_body() bytes {
  return from_array([])
}
